# Spotify Developer Dashboard (https://developer.spotify.com/dashboard) で作成したアプリの値
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# Spotify のアプリ設定に登録した Redirect URI と完全に一致させること
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Google Cloud Console のOAuthクライアント（デスクトップアプリ）の値
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web UI ---------------------------------------------------------------
# 既定は自分のマシンからのみアクセス可。
WEB_HOST=127.0.0.1
WEB_PORT=8765
# スマホなど別端末から使う場合は WEB_HOST=0.0.0.0 にしたうえで、
# WEB_TOKEN を必ず設定すること（未設定だと起動を拒否する）。
# 生成: make token
WEB_TOKEN=
# 登録用トークン。プレイリストの登録・同期・実行だけ許可（解除や手動修正は不可）。
WEB_QUEUE_TOKEN=
# 閲覧専用のトークン。これで開くと状況は見えるが操作は一切できない（スマホ向け）。
WEB_VIEW_TOKEN=

